# =================================================================
# REPURPOSELY AI - CẤU HÌNH MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# =================================================================

# 1. Cơ sở dữ liệu MongoDB (Tương thích trực tiếp với MongoDB Compass)
# Nếu bạn chạy MongoDB cục bộ trên máy, URL mặc định là:
MONGODB_URI="mongodb://localhost:27017/repurposely"
# Nếu bạn dùng MongoDB Atlas Cloud:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/repurposely?retryWrites=true&w=majority"

# 2. Google Gemini API Key (để sinh bài viết bằng Gemini Flash)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 3. NextAuth.js (Auth.js v5) Secret
AUTH_SECRET="repurposely-ai-super-secret-key-min-32-chars-length"
AUTH_TRUST_HOST=true

# 4. Google OAuth (Đăng nhập Google)
# Tạo credentials tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
